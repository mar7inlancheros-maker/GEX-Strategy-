# Copia este archivo a `.env` dentro de GEX_Asset_Management/ y rellena el valor.
# `.env` nunca se sube a GitHub (está en .gitignore).

# API key de Databento — https://databento.com  (Portal -> API keys)
# La leen run_ingesta.py y los scripts fase0*.py, de aquí o de la variable de
# entorno DATABENTO_API_KEY. Nunca se pasa por línea de comandos.
DATABENTO_API_KEY=
